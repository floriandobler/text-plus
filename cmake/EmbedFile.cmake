# embed_files(<output.cpp> <namespace> <name1> <file1> [<name2> <file2> ...])
# Writes a C++ file with one byte array per input file:
#   namespace <ns> { extern const unsigned char <name>[]; extern const unsigned long <name>Size; }
function(embed_files OUTPUT NS)
    set(args ${ARGN})
    set(content "// Generated by cmake/EmbedFile.cmake - do not edit\nnamespace ${NS}\n{\n")
    set(deps "")
    list(LENGTH args n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} name)
        list(GET args ${j} file)
        list(APPEND deps ${file})
        file(READ ${file} hex HEX)
        string(LENGTH "${hex}" hexLen)
        math(EXPR size "${hexLen} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
        string(APPEND content "extern const unsigned char ${name}[];\nextern const unsigned long ${name}Size;\nalignas(16) const unsigned char ${name}[] = {\n${hex}\n};\nconst unsigned long ${name}Size = ${size};\n")
    endforeach()
    string(APPEND content "}\n")
    file(WRITE ${OUTPUT}.tmp "${content}")
    configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${deps})
endfunction()
